# Only reviewed source files enter this repository.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/requirements-build.txt
!/docs/
/docs/*
!/docs/*.md

!/server/
/server/*
!/server/server.py
!/server/offline_policy.json
!/server/config/
/server/config/*
!/server/config/lunar_festivals.json
!/server/config/solar_terms.json

!/client/
/client/*
!/client/js/
/client/js/*
!/client/js/calendar.offline.js

!/desktop/
/desktop/*
!/desktop/*.py
!/desktop/FrogWindow.cs
!/desktop/MacApp.swift
!/desktop/mac-scroll.js
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/macos.yml
!/mobile/
/mobile/*
!/mobile/*.py
!/mobile/*.js
!/mobile/*.html
!/mobile/studio.css
!/mobile/android/
/mobile/android/*
!/mobile/android/*.java
!/packaging/
/packaging/*
!/packaging/*.py
!/packaging/*.spec
!/packaging/*.iss
!/packaging/*.md
!/packaging/android/
/packaging/android/*
!/packaging/android/*.smali
!/packaging/android/*.js

!/tools/
/tools/*
!/tools/README.md
!/tools/build_gallery_client.py
!/tools/build_gallery_state.py
!/tools/complete_gallery_state.py
!/tools/prepare_gallery_apk.py
!/tools/patch_album_pages.py
!/tools/test_logic_audit.py
!/tools/test_seasonal_activities.py
!/tools/test_portable_saves.py
!/tools/test_desktop_browser.cjs
!/tools/test_desktop_lifecycle.py
!/tools/test_courtyard_traveler.py
!/tools/test_weekend_lottery.py
!/tools/test_mobile_browser.cjs
!/tools/capture/
/tools/capture/*
!/tools/capture/*.py
!/tools/resources/
/tools/resources/*
!/tools/resources/scan_eab_cache.py
!/tools/resources/mirror_frog_hotfix_resources.py
!/tools/resources/pack_picture_cache.py
!/tools/travelmap/
/tools/travelmap/*
!/tools/travelmap/*.py
!/tools/patches/
/tools/patches/*
!/tools/patches/current/
/tools/patches/current/*
!/tools/patches/current/*.py
!/tools/patches/current/*.cjs

# Local data, binaries and captures stay private, even inside source folders.
**/__pycache__/
*.py[cod]
*.apk
*.eab
*.exe
*.dll
*.jar
*.zip
*.tar
*.log
*.jsonl
*.bak
*.before_*
**/*LOCAL_ONLY*
**/state.json
**/gallery_state.json
**/.env
**/.env.*
*.key
*.pem
*.p12
*.jks
*.keystore
